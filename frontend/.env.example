# Copie este arquivo para .env e coloque a URL do backend.
# No seu PC: o backend local (ele aceita o front em http://localhost:8081, com cookie de login).
# No deploy, a pipeline grava EXPO_PUBLIC_API_URL=proxy: o front chama /api na própria Vercel, que repassa pro Render.
EXPO_PUBLIC_API_URL=http://localhost:8080
